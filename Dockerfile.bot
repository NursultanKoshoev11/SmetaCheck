FROM golang:1.23-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/bot ./cmd/bot

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S smetacheck \
    && adduser -S smetacheck -G smetacheck
COPY --from=build --chown=smetacheck:smetacheck /out/bot /app/bot
USER smetacheck
ENTRYPOINT ["/app/bot"]
