FROM golang:1.23-alpine AS build
WORKDIR /src
RUN apk add --no-cache ca-certificates
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.20
WORKDIR /app
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S smetacheck \
    && adduser -S smetacheck -G smetacheck \
    && mkdir -p /var/lib/smetacheck/uploads /var/lib/smetacheck/reports \
    && chown -R smetacheck:smetacheck /var/lib/smetacheck
COPY --from=build --chown=smetacheck:smetacheck /out/worker /app/worker
USER smetacheck
ENTRYPOINT ["/app/worker"]
