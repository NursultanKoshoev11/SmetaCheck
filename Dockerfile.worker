FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/worker ./cmd/worker

FROM alpine:3.20
WORKDIR /app
RUN addgroup -S smetacheck \
    && adduser -S smetacheck -G smetacheck \
    && mkdir -p /var/lib/smetacheck/uploads /var/lib/smetacheck/reports \
    && chown -R smetacheck:smetacheck /var/lib/smetacheck
COPY --from=build /out/worker /app/worker
USER smetacheck
CMD ["/app/worker"]
