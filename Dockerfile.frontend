FROM node:20-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

FROM node:20-alpine AS build
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_BASE
ENV NEXT_PUBLIC_API_BASE=$NEXT_PUBLIC_API_BASE
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ ./
RUN npm run build

FROM node:20-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
RUN addgroup -S smetacheck && adduser -S smetacheck -G smetacheck
COPY --from=build --chown=smetacheck:smetacheck /app/package.json /app/package-lock.json ./
COPY --from=build --chown=smetacheck:smetacheck /app/node_modules ./node_modules
COPY --from=build --chown=smetacheck:smetacheck /app/.next ./.next
USER smetacheck
EXPOSE 3000
ENTRYPOINT ["npm", "run", "start"]
