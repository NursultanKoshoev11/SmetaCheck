# =========================
# ОБЯЗАТЕЛЬНЫЕ НАСТРОЙКИ
# =========================
POSTGRES_USER=crypto
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=crypto_analyzer
POSTGRES_SSLMODE=disable

TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_BOTFATHER_TOKEN
TELEGRAM_CHAT_ID=123456789

# Защищает HTTP API. Используйте длинную случайную строку.
API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_API_KEY

# =========================
# ПРИЛОЖЕНИЕ
# =========================
APP_NAME=Crypto Pattern Analyzer
APP_ENV=production
HTTP_PORT=8085
LOG_LEVEL=info

# Сканирование запускается каждый час на указанной минуте UTC.
# 02 означает 00:02, 01:02, 02:02 и так далее — после закрытия часовой свечи.
SCAN_MINUTE=2
RUN_ON_STARTUP=true

# =========================
# BINANCE И СПИСОК МОНЕТ
# =========================
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
QUOTE_ASSET=USDT

# 150 = анализировать 150 самых ликвидных подходящих пар.
# 0 = анализировать все подходящие пары, что значительно увеличит нагрузку.
MAX_SYMBOLS=150
MIN_24H_QUOTE_VOLUME=1000000
EXCLUDED_BASE_ASSETS=USDC,FDUSD,TUSD,USDP,DAI,EUR,TRY,BRL,GBP,AUD,RUB,BIDR,IDRT,UAH,NGN,BVND

ANALYSIS_INTERVALS=15m,1h,4h,1d
KLINE_LIMIT=1000
REQUEST_CONCURRENCY=6
REQUEST_DELAY=120ms
HTTP_TIMEOUT=20s

# =========================
# ИСТОРИЧЕСКИЙ ПОИСК ПАТТЕРНОВ
# =========================
NEAREST_NEIGHBORS=40
MINIMUM_SAMPLES=120
MINIMUM_PROBABILITY=0.58
MINIMUM_EDGE=0.06
MULTITF_SIGNAL_THRESHOLD=0.12

LOOKAHEAD_15M=16
LOOKAHEAD_1H=12
LOOKAHEAD_4H=6
LOOKAHEAD_1D=7

TARGET_PCT_15M=1.5
TARGET_PCT_1H=3.0
TARGET_PCT_4H=5.0
TARGET_PCT_1D=8.0

WEIGHT_15M=0.15
WEIGHT_1H=0.35
WEIGHT_4H=0.35
WEIGHT_1D=0.15

# =========================
# ФЬЮЧЕРСНЫЕ РЫНОЧНЫЕ МЕТРИКИ
# Только публичные данные; сервис не открывает сделки.
# =========================
ENABLE_FUTURES_METRICS=true
FUTURES_ENRICH_LIMIT=30

# =========================
# TELEGRAM
# =========================
REPORT_TOP_N=10
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_SEND_EMPTY_REPORT=true
