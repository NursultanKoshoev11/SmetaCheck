APP_ENV=development
APP_NAME=SmetaCheck KG
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=smetacheck
POSTGRES_PASSWORD=smetacheck_local_password
POSTGRES_DB=smetacheck
DATABASE_URL=postgres://smetacheck:smetacheck_local_password@localhost:5432/smetacheck?sslmode=disable
REDIS_ADDR=localhost:6379

JWT_SECRET=local_development_secret_not_for_production_change_before_deploy_64_chars
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_MB=25

SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local_development_webhook_secret
TELEGRAM_ADMIN_CHAT_ID=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.2:3000
