# SmetaCheck KG production environment template
# Copy to .env on the server and replace every placeholder before deployment.

APP_ENV=production
APP_NAME=SmetaCheck KG
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://app.smetacheck.kg
API_PUBLIC_BASE_URL=https://api.smetacheck.kg
APP_DOMAIN=app.smetacheck.kg
API_DOMAIN=api.smetacheck.kg
ACME_EMAIL=admin@smetacheck.kg

# Database
POSTGRES_USER=smetacheck
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=smetacheck
DATABASE_URL=postgres://smetacheck:REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD@postgres:5432/smetacheck?sslmode=disable

# Redis
REDIS_ADDR=redis:6379

# Security
JWT_SECRET=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS_MINIMUM
COOKIE_SECURE=true
TELEGRAM_WEBHOOK_SECRET=REPLACE_WITH_LONG_RANDOM_WEBHOOK_SECRET
ALLOWED_ORIGINS=https://smetacheck.kg,https://www.smetacheck.kg,https://app.smetacheck.kg

# Transactional email
# SMTP_TLS_MODE: starttls for port 587, implicit for port 465.
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_TLS_MODE=starttls
SMTP_TIMEOUT=15s
SMTP_USERNAME=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=no-reply@smetacheck.kg
SMTP_FROM_NAME=SmetaCheck KG

# Google OpenID Connect
GOOGLE_OIDC_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_OIDC_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_OIDC_REDIRECT_URL=https://api.smetacheck.kg/v1/auth/google/callback

# Telegram OpenID Connect
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=REPLACE_WITH_TELEGRAM_CLIENT_ID
TELEGRAM_OIDC_CLIENT_SECRET=REPLACE_WITH_TELEGRAM_CLIENT_SECRET
TELEGRAM_OIDC_REDIRECT_URL=https://api.smetacheck.kg/v1/auth/telegram/callback

# Storage and uploads
UPLOAD_DIR=/var/lib/smetacheck/uploads
REPORT_DIR=/var/lib/smetacheck/reports
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=10
MULTIPART_MEMORY_MB=32
BATCH_FILE_RETENTION_DAYS=30
BATCH_CLEANUP_INTERVAL=6h

# Server timeouts
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=60s

# AI provider: rules, openai, gemini, anthropic
AI_PROVIDER=openai
AI_ALLOW_REQUEST_PROVIDER_OVERRIDE=false
AI_TIMEOUT=45s
AI_HTTP_MAX_ATTEMPTS=3
AI_MAX_OUTPUT_TOKENS=3000
AI_ROWS_PER_CHUNK=250
AI_MAX_RAW_FILE_MB=20
AI_BATCH_MAX_ATTEMPTS=3
AI_BATCH_LOCK_TIMEOUT=15m
AI_BATCH_HEARTBEAT_INTERVAL=30s
AI_BATCH_TIMEOUT=30m
WORKER_POLL_INTERVAL=2s

# Models that may be selected per request when override is enabled.
AI_ALLOWED_OPENAI_MODELS=gpt-4.1-mini
AI_ALLOWED_GEMINI_MODELS=gemini-2.5-flash
AI_ALLOWED_ANTHROPIC_MODELS=claude-sonnet-4-5

# OpenAI
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini; required only when AI_PROVIDER=gemini or selected through override.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic; required only when AI_PROVIDER=anthropic or selected through override.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Frontend build
NEXT_PUBLIC_API_BASE=https://api.smetacheck.kg

# Backups
BACKUP_DIR=/var/backups/smetacheck
BACKUP_RETENTION_DAYS=14
