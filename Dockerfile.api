FROM golang:1.23-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/api ./cmd/api

FROM alpine:3.20
WORKDIR /app
RUN addgroup -S smetacheck && adduser -S smetacheck -G smetacheck
COPY --from=build /out/api /app/api
USER smetacheck
EXPOSE 8080
CMD ["/app/api"]
