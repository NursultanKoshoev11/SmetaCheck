APP_ENV=production
APP_NAME=SmetaCheck KG
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://smetacheck.kg
DATABASE_URL=postgres://smetacheck:smetacheck_change_me@postgres:5432/smetacheck?sslmode=disable
REDIS_ADDR=redis:6379
JWT_SECRET=change_me_to_64_random_chars_minimum
UPLOAD_DIR=/var/lib/smetacheck/uploads
REPORT_DIR=/var/lib/smetacheck/reports
MAX_UPLOAD_MB=25
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change_me
TELEGRAM_ADMIN_CHAT_ID=
ALLOWED_ORIGINS=https://smetacheck.kg,https://www.smetacheck.kg
