APP_ENV=production
APP_NAME=SmetaCheck KG
HTTP_ADDR=:8080
PUBLIC_BASE_URL=https://smetacheck.kg

POSTGRES_USER=smetacheck
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=smetacheck
DATABASE_URL=postgres://smetacheck:replace_with_strong_database_password@postgres:5432/smetacheck?sslmode=disable
REDIS_ADDR=redis:6379

JWT_SECRET=replace_with_64_plus_random_characters
UPLOAD_DIR=/var/lib/smetacheck/uploads
REPORT_DIR=/var/lib/smetacheck/reports
MAX_UPLOAD_MB=25

SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=60s

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace_with_strong_webhook_secret
TELEGRAM_ADMIN_CHAT_ID=

ALLOWED_ORIGINS=https://smetacheck.kg,https://www.smetacheck.kg,http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.2:3000
