APP_ENV=development
APP_NAME=SmetaCheck KG
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:3000
API_PUBLIC_BASE_URL=http://localhost:8080

POSTGRES_USER=smetacheck
POSTGRES_PASSWORD=smetacheck_dev_password
POSTGRES_DB=smetacheck
DATABASE_URL=postgres://smetacheck:smetacheck_dev_password@postgres:5432/smetacheck?sslmode=disable
REDIS_ADDR=redis:6379

JWT_SECRET=smetacheck_local_development_jwt_secret_please_change_before_production
COOKIE_SECURE=false
UPLOAD_DIR=/var/lib/smetacheck/uploads
REPORT_DIR=/var/lib/smetacheck/reports
MAX_UPLOAD_MB=25
MAX_BATCH_FILES=10

SERVER_READ_HEADER_TIMEOUT=5s
SERVER_READ_TIMEOUT=60s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=60s

# Transactional email. Email registration and password reset are disabled until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=SmetaCheck KG

# Google OpenID Connect. Register this callback URL:
# http://localhost:8080/v1/auth/google/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URL=http://localhost:8080/v1/auth/google/callback

# Telegram OpenID Connect. Configure the provider and callback for your Telegram application.
TELEGRAM_OIDC_ISSUER=https://oauth.telegram.org
TELEGRAM_OIDC_CLIENT_ID=
TELEGRAM_OIDC_CLIENT_SECRET=
TELEGRAM_OIDC_REDIRECT_URL=http://localhost:8080/v1/auth/telegram/callback

# AI analysis. Use rules for free local development.
AI_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT=35s
AI_MAX_OUTPUT_TOKENS=1800
AI_ROWS_PER_CHUNK=250

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=local_development_webhook_secret
TELEGRAM_ADMIN_CHAT_ID=

NEXT_PUBLIC_API_BASE=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
